# Optional. When set, the contact form POSTs JSON to this URL.
# Example Formspree endpoint: https://formspree.io/f/xxxxxxxx
# Leave unset to open the visitor's email app with the message filled in.
VITE_CONTACT_ENDPOINT=

# Optional. Loaded only after a visitor allows analytics.
# Example: https://plausible.io/js/script.js
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_DOMAIN=
